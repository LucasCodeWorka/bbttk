{
  "name": "api",
  "version": "1.0.0",
  "description": "API Backend Bebetenkite Dashboard",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "sync:custo-preco-sku-filial": "tsx src/scripts/sync-custo-preco-sku-filial.ts",
    "sync:custo-preco-sku-filial:dryrun": "tsx src/scripts/sync-custo-preco-sku-filial.ts --dry-run",
    "sync:em-producao": "tsx src/scripts/sync-em-producao.ts",
    "sync:em-producao:dryrun": "tsx src/scripts/sync-em-producao.ts --dry-run",
    "sync:em-producao:dryrun-detalhado": "tsx src/scripts/sync-em-producao.ts --dry-run --detalhado",
    "import:saldos-historicos": "tsx src/scripts/import-saldos-historicos.ts --apply",
    "import:saldos-historicos:dryrun": "tsx src/scripts/import-saldos-historicos.ts",
    "sync:produtos-faltantes-saldos": "tsx src/scripts/sync-produtos-faltantes-saldos.ts --apply",
    "sync:produtos-faltantes-saldos:dryrun": "tsx src/scripts/sync-produtos-faltantes-saldos.ts",
    "recalc:estoque-aa-saldos": "tsx src/scripts/recalcular-estoque-aa-saldos.ts --apply",
    "recalc:estoque-aa-saldos:dryrun": "tsx src/scripts/recalcular-estoque-aa-saldos.ts",
    "recalc:estoque-aa-saldos:latest": "tsx src/scripts/recalcular-estoque-aa-saldos.ts --apply --latest",
    "rebuild:estoque-transito": "tsx src/scripts/rebuild-estoque-transito.ts --apply",
    "rebuild:estoque-transito:dryrun": "tsx src/scripts/rebuild-estoque-transito.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}

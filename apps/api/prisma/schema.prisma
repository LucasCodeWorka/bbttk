generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       Int                       @id @default(autoincrement())
  email                    String                    @unique @db.VarChar(255)
  passwordHash             String                    @map("password_hash") @db.VarChar(255)
  name                     String                    @db.VarChar(100)
  role                     String                    @db.VarChar(20)
  branchCodes              Int[]                     @map("branch_codes")
  sellerCode               Int?                      @map("seller_code")
  isActive                 Boolean?                  @default(true) @map("is_active")
  createdAt                DateTime?                 @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                DateTime?                 @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  moduleAccess             String[]                  @default([]) @map("module_access")
  agrupamentoGrupos        AgrupamentoGrupo[]
  metaDistributions        MetaDistribution[]
  pcpCoberturaIdealFiliais PcpCoberturaIdealFilial[]
  pcpCurvaAbcConfigs       PcpCurvaAbcConfig[]
  pcpMetaVisaoGerais       PcpMetaVisaoGeral[]
  pcpRelatorioConfigs      PcpRelatorioConfig[]

  @@map("users")
}

model MetaDistribution {
  id               Int                @id @default(autoincrement())
  name             String?            @db.VarChar(100)
  ano              Int
  mes              Int
  totalValue       Decimal            @map("total_value") @db.Decimal(15, 2)
  distributionType String?            @map("distribution_type") @db.VarChar(20)
  createdById      Int?               @map("created_by")
  createdAt        DateTime?          @default(now()) @map("created_at") @db.Timestamp(6)
  items            DistributionItem[]
  createdBy        User?              @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("meta_distributions")
}

model DistributionItem {
  id             Int               @id @default(autoincrement())
  distributionId Int?              @map("distribution_id")
  branchCode     Int               @map("branch_code")
  sellerCode     Int?              @map("seller_code")
  percentage     Decimal           @db.Decimal(5, 2)
  valorCalculado Decimal           @map("valor_calculado") @db.Decimal(15, 2)
  nivel1         Decimal?          @map("nivel_1") @db.Decimal(15, 2)
  nivel2         Decimal?          @map("nivel_2") @db.Decimal(15, 2)
  nivel3         Decimal?          @map("nivel_3") @db.Decimal(15, 2)
  nivel4         Decimal?          @map("nivel_4") @db.Decimal(15, 2)
  nivel5         Decimal?          @map("nivel_5") @db.Decimal(15, 2)
  distribution   MetaDistribution? @relation(fields: [distributionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("distribution_items")
}

model Meta {
  id             Int       @id @default(autoincrement())
  ano            Int
  mes            Int
  branchCode     Int       @map("branch_code")
  sellerCode     Int?      @map("seller_code")
  nivel1         Decimal?  @default(0) @map("nivel_1") @db.Decimal(15, 2)
  nivel2         Decimal?  @default(0) @map("nivel_2") @db.Decimal(15, 2)
  nivel3         Decimal?  @default(0) @map("nivel_3") @db.Decimal(15, 2)
  nivel4         Decimal?  @default(0) @map("nivel_4") @db.Decimal(15, 2)
  nivel5         Decimal?  @default(0) @map("nivel_5") @db.Decimal(15, 2)
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  comissaoNivel1 Decimal?  @map("comissao_nivel_1") @db.Decimal(5, 2)
  comissaoNivel2 Decimal?  @map("comissao_nivel_2") @db.Decimal(5, 2)
  comissaoNivel3 Decimal?  @map("comissao_nivel_3") @db.Decimal(5, 2)
  comissaoNivel4 Decimal?  @map("comissao_nivel_4") @db.Decimal(5, 2)
  comissaoNivel5 Decimal?  @map("comissao_nivel_5") @db.Decimal(5, 2)

  @@unique([ano, mes, branchCode, sellerCode])
  @@index([branchCode], map: "idx_metas_branch")
  @@index([ano, mes], map: "idx_metas_periodo")
  @@index([sellerCode], map: "idx_metas_seller")
  @@map("metas")
}

model MetaNivel {
  id                 Int       @id @default(autoincrement())
  nivelOrdem         Int       @unique @map("nivel_ordem")
  nivelNome          String    @map("nivel_nome") @db.VarChar(50)
  nivelCor           String?   @default("#888888") @map("nivel_cor") @db.VarChar(20)
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  comissaoPercentual Decimal   @default(0) @map("comissao_percentual") @db.Decimal(5, 2)

  @@map("meta_niveis")
}

model ClassificacaoOperacao {
  operationCode  Int      @id @map("operation_code")
  description    String?  @db.VarChar(255)
  isFinancial    Boolean? @map("is_financial")
  operationsType String?  @map("operations_type") @db.VarChar(5)
  operationMode  String?  @map("operation_mode") @db.VarChar(5)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("classificacao_operacoes")
}

model branches {
  branch_code       Int         @id
  branch_name       String      @db.VarChar(100)
  updated_at        DateTime?   @default(now()) @db.Timestamp(6)
  description       String?     @db.VarChar(255)
  fantasy_name      String?     @db.VarChar(150)
  branch_group_name String?     @db.VarChar(100)
  cnpj              String?     @db.VarChar(20)
  person_code       BigInt?
  last_change       DateTime?   @db.Timestamp(6)
  dados_api         Json?
  abrev             String?     @db.VarChar(10)
  prd_saldo         prd_saldo[]
}

model etl_log {
  id                 Int       @id @default(autoincrement())
  branch_code        Int
  extract_date       DateTime  @db.Date
  transactions_count Int?
  items_count        Int?
  status             String?   @db.VarChar(20)
  error_message      String?
  started_at         DateTime? @db.Timestamp(6)
  finished_at        DateTime? @db.Timestamp(6)

  @@unique([branch_code, extract_date])
}

model operacoes {
  operation_code  Int       @id
  name            String?   @db.VarChar(255)
  operation_mode  String?   @db.VarChar(10)
  operations_type String?   @db.VarChar(10)
  invoice_data    Json?
  created_at      DateTime? @default(now()) @db.Timestamp(6)
}

model prd_saldo {
  id                        BigInt    @id @default(autoincrement())
  product_sku               String    @db.VarChar(50)
  branch_code               Int
  stock_code                Int
  stock_description         String?   @db.VarChar(100)
  stock                     Decimal?  @db.Decimal(14, 3)
  sales_order               Decimal?  @db.Decimal(14, 3)
  input_transaction         Decimal?  @db.Decimal(14, 3)
  output_transaction        Decimal?  @db.Decimal(14, 3)
  production_planning       Decimal?  @db.Decimal(14, 3)
  purchase_order            Decimal?  @db.Decimal(14, 3)
  production_order_progress Decimal?  @db.Decimal(14, 3)
  production_order_wait_lib Decimal?  @db.Decimal(14, 3)
  stock_temp                Decimal?  @db.Decimal(14, 3)
  totvs_change_date         DateTime? @db.Timestamp(6)
  captured_at               DateTime  @default(now()) @db.Timestamp(6)
  is_full_snapshot          Boolean   @default(false)
  product_code              Int
  branches                  branches  @relation(fields: [branch_code], references: [branch_code], onDelete: NoAction, onUpdate: NoAction)
  produtos                  produtos  @relation(fields: [product_sku], references: [product_sku], onDelete: Cascade, onUpdate: NoAction)

  @@index([branch_code], map: "idx_prd_saldo_branch")
  @@index([product_code, branch_code, stock_code, captured_at(sort: Desc)], map: "idx_prd_saldo_product_code_key_date")
  @@index([product_sku], map: "idx_prd_saldo_product_sku")
  @@index([totvs_change_date], map: "idx_prd_saldo_totvs_change_date")
}

model produtos {
  product_sku           String                  @id @db.VarChar(50)
  product_name          String?                 @db.VarChar(255)
  color_code            String?                 @db.VarChar(10)
  color_name            String?                 @db.VarChar(100)
  size                  String?                 @db.VarChar(20)
  ncm                   String?                 @db.VarChar(20)
  cst                   String?                 @db.VarChar(10)
  cest                  String?                 @db.VarChar(20)
  is_active             Boolean?
  is_finished_product   Boolean?
  is_raw_material       Boolean?
  is_bulk_material      Boolean?
  is_own_production     Boolean?
  measured_unit         String?                 @db.VarChar(10)
  minimum_stock_amount  Decimal?                @db.Decimal(10, 2)
  maximum_stock_amount  Decimal?                @db.Decimal(10, 2)
  ideal_stock_amount    Decimal?                @db.Decimal(10, 2)
  reference_code        String?                 @db.VarChar(100)
  reference_id          Int?
  reference_name        String?                 @db.VarChar(255)
  last_reference_code   String?                 @db.VarChar(50)
  grid_code             Int?
  description           String?
  is_blocked            Boolean?
  created_at            DateTime?               @default(now()) @db.Timestamp(6)
  updated_at            DateTime?               @default(now()) @db.Timestamp(6)
  product_code          Int?
  prd_saldo             prd_saldo[]
  produto_classificacao produto_classificacao[]

  @@index([color_code], map: "idx_color_code")
  @@index([grid_code], map: "idx_grid_code")
  @@index([is_active], map: "idx_is_active")
  @@index([product_code], map: "idx_product_code")
  @@index([reference_code], map: "idx_reference_code")
}

model sync_state {
  sync_key   String    @id @db.VarChar(100)
  sync_value String
  updated_at DateTime? @default(now()) @db.Timestamp(6)
}

model transacao_itens {
  id                  Int       @id @default(autoincrement())
  branch_code         Int
  transaction_code    Int
  item_index          Int
  product_code        Int
  measured_unit       String?   @db.VarChar(10)
  quantity            Decimal?  @db.Decimal(15, 4)
  value               Decimal?  @db.Decimal(15, 4)
  unit_discount_value Decimal?  @db.Decimal(15, 4)
  net_value           Decimal?  @db.Decimal(15, 4)
  seller_code         Int?
  price_table         String?   @db.VarChar(100)
  created_at          DateTime? @default(now()) @db.Timestamp(6)
  updated_at          DateTime? @default(now()) @db.Timestamp(6)

  @@unique([branch_code, transaction_code, item_index])
  @@index([product_code], map: "idx_itens_product")
  @@index([branch_code, transaction_code], map: "idx_itens_transaction")
}

model transacoes {
  id                     Int       @id @default(autoincrement())
  branch_code            Int
  branch_name            String?   @db.VarChar(100)
  transaction_code       Int
  transaction_date       DateTime  @db.Date
  customer_code          BigInt?
  last_change_date       DateTime? @db.Timestamp(6)
  operation_code         Int?
  seller_code            Int?
  guide_code             Int?
  payment_condition_code Int?
  price_table_code       Int?
  status                 Int?
  origin_destination     String?   @db.VarChar(255)
  additional_information String?
  created_at             DateTime? @default(now()) @db.Timestamp(6)
  updated_at             DateTime? @default(now()) @db.Timestamp(6)

  @@unique([branch_code, transaction_code])
  @@index([branch_code], map: "idx_transacoes_branch")
  @@index([transaction_date], map: "idx_transacoes_date")
  @@index([operation_code], map: "idx_transacoes_operation")
  @@index([status], map: "idx_transacoes_status")
}

model AgrupamentoGrupo {
  id          Int                 @id @default(autoincrement())
  tipo        String              @db.VarChar(50)
  nome        String              @db.VarChar(100)
  createdById Int?                @map("created_by")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  createdBy   User?               @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  membros     AgrupamentoMembro[]

  @@unique([tipo, nome])
  @@map("agrupamento_grupos")
}

model AgrupamentoMembro {
  id            Int              @id @default(autoincrement())
  grupoId       Int              @map("grupo_id")
  tipo          String           @db.VarChar(50)
  referenceCode String           @map("reference_code") @db.VarChar(100)
  colorCode     String?          @map("color_code") @db.VarChar(10)
  colorName     String?          @map("color_name") @db.VarChar(100)
  colorMatchKey String           @map("color_match_key") @db.VarChar(100)
  createdAt     DateTime         @default(now()) @map("created_at")
  grupo         AgrupamentoGrupo @relation(fields: [grupoId], references: [id], onDelete: Cascade)

  @@unique([tipo, referenceCode, colorMatchKey])
  @@map("agrupamento_membros")
}

model PcpRelatorioConfig {
  id                      Int      @id @default(autoincrement())
  relatorio               String   @unique @db.VarChar(50)
  giroDias                Int      @default(30) @map("giro_dias")
  coberturaMeses          Int      @default(3) @map("cobertura_meses")
  atacadoCoberturaBase    String   @default("fabrica_total") @map("atacado_cobertura_base") @db.VarChar(20)
  createdById             Int?     @map("created_by")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")
  // Defaults pedidos pelo usuario pra Custo/PDV do Configurador (Custo=ULTIMA COMPRA,
  // PDV Varejo=VAREJO, PDV Atacado=ATACADO, Loja de referencia=IGUATEMI) - codigos
  // confirmados direto em produto_custos/produto_precos (nomes reais sincronizados do
  // TOTVS), pra um relatorio novo (create no upsert) ja nascer configurado assim em
  // vez de com o codigo generico "MEDIO S/ IMPOSTO".
  custoCode               Int      @default(2) @map("custo_code")
  pdvAtacadoCode          Int      @default(3) @map("pdv_atacado_code")
  pdvVarejoCode           Int      @default(1) @map("pdv_varejo_code")
  precoCustoBranchCode    Int      @default(1) @map("preco_custo_branch_code")
  riscoCoberturaMeses     Decimal  @default(1) @map("risco_cobertura_meses") @db.Decimal(6, 2)
  coberturaLimiteVerde    Decimal  @default(4.00) @map("cobertura_limite_verde") @db.Decimal(6, 2)
  coberturaLimiteVermelho Decimal  @default(4.01) @map("cobertura_limite_vermelho") @db.Decimal(6, 2)
  maturacaoDias           Int      @default(30) @map("maturacao_dias")
  createdBy               User?    @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("pcp_relatorio_configs")
}

model ProdutoCusto {
  id          Int      @id @default(autoincrement())
  productCode Int      @map("product_code")
  branchCode  Int      @map("branch_code")
  costCode    Int      @map("cost_code")
  costName    String?  @map("cost_name") @db.VarChar(100)
  valor       Decimal  @db.Decimal(15, 4)
  syncedAt    DateTime @default(now()) @updatedAt @map("synced_at")

  @@unique([productCode, branchCode, costCode])
  @@index([productCode])
  @@map("produto_custos")
}

model ProdutoPreco {
  id          Int      @id @default(autoincrement())
  productCode Int      @map("product_code")
  branchCode  Int      @map("branch_code")
  priceCode   Int      @map("price_code")
  priceName   String?  @map("price_name") @db.VarChar(100)
  valor       Decimal  @db.Decimal(15, 4)
  syncedAt    DateTime @default(now()) @updatedAt @map("synced_at")

  @@unique([productCode, branchCode, priceCode])
  @@index([productCode])
  @@map("produto_precos")
}

// Snapshot do que esta "em producao" agora (Ordens de Producao do TOTVS ainda nao
// finalizadas: status 10=Aguardando, 20=Em Andamento), quantidade PENDENTE de cada
// item da O.P. (production-order/v2/orders/search, expand=items), somada por
// product_code x branch_code (filial/unidade fabril dona da O.P.). Tabela e sempre
// REGRAVADA por inteiro a cada sync (DELETE + INSERT dentro de uma transacao) em vez
// de upsert incremental - uma O.P. que finalizou/cancelou tem que sumir daqui, nao so
// parar de ser atualizada, e nao da pra saber isso so olhando o que "nao veio" na
// pagina atual sem comparar contra o estado inteiro anterior.
model ProdutoEmProducao {
  id          Int      @id @default(autoincrement())
  productCode Int      @map("product_code")
  branchCode  Int      @map("branch_code")
  quantidade  Decimal  @db.Decimal(15, 4)
  syncedAt    DateTime @default(now()) @map("synced_at")

  @@unique([productCode, branchCode])
  @@index([productCode])
  @@map("produto_em_producao")
}

model PcpCoberturaIdealFilial {
  id                  Int      @id @default(autoincrement())
  relatorio           String   @db.VarChar(50)
  branchCode          Int      @map("branch_code")
  coberturaIdealMeses Decimal  @map("cobertura_ideal_meses") @db.Decimal(6, 2)
  createdById         Int?     @map("created_by")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  createdBy           User?    @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([relatorio, branchCode])
  @@map("pcp_cobertura_ideal_filiais")
}

model PcpMetaVisaoGeral {
  id                        Int      @id @default(autoincrement())
  relatorio                 String   @unique @db.VarChar(50)
  metaCoberturaGeralMeses   Decimal  @default(3.5) @map("meta_cobertura_geral_meses") @db.Decimal(6, 2)
  metaGiroAnualizado        Decimal  @default(3.4) @map("meta_giro_anualizado") @db.Decimal(6, 2)
  metaEstoqueMortoPercent   Decimal  @default(10) @map("meta_estoque_morto_percent") @db.Decimal(6, 2)
  metaCoberturaBasicoMeses  Decimal  @default(3.0) @map("meta_cobertura_basico_meses") @db.Decimal(6, 2)
  metaCoberturaColecaoMeses Decimal  @default(1.5) @map("meta_cobertura_colecao_meses") @db.Decimal(6, 2)
  estoqueMortoDias          Int      @default(180) @map("estoque_morto_dias")
  createdById               Int?     @map("created_by")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")
  createdBy                 User?    @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("pcp_meta_visao_geral")
}

model PcpCurvaAbcConfig {
  id                  Int      @id @default(autoincrement())
  relatorio           String   @unique @db.VarChar(50)
  giroDias            Int      @default(90) @map("giro_dias")
  curvaALimitePercent Int      @default(80) @map("meta_curva_a_unidades")
  curvaBLimitePercent Decimal  @default(95) @map("curva_d_percent") @db.Decimal(5, 2)
  curvaCLimitePercent Decimal  @default(99) @map("curva_c_percent") @db.Decimal(5, 2)
  createdById         Int?     @map("created_by")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  createdBy           User?    @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("pcp_curva_abc_config")
}

model dim_classification_type {
  source_key               String    @id @db.VarChar(100)
  classification_type_code Int?
  classification_type_name String?   @db.VarChar(255)
  description              String?
  is_active                Boolean?
  raw_data                 Json
  created_at               DateTime? @default(now()) @db.Timestamp(6)
  updated_at               DateTime? @default(now()) @db.Timestamp(6)

  @@index([classification_type_code], map: "idx_dim_classification_type_code")
  @@index([classification_type_name], map: "idx_dim_classification_type_name")
}

model dim_classification {
  source_key                   String    @id @db.VarChar(150)
  classification_type_code     Int?
  classification_type_name     String?   @db.VarChar(255)
  classification_type_name_aux String?   @db.VarChar(255)
  classification_code          String?   @db.VarChar(100)
  classification_name          String?   @db.VarChar(255)
  classification_name_aux      String?   @db.VarChar(255)
  max_change_filter_date       DateTime? @db.Timestamp(6)
  raw_data                     Json
  created_at                   DateTime? @default(now()) @db.Timestamp(6)
  updated_at                   DateTime? @default(now()) @db.Timestamp(6)

  @@index([classification_code], map: "idx_dim_classification_code")
  @@index([classification_name], map: "idx_dim_classification_name")
}

model dim_cliente {
  idcliente                Int       @id
  tipo_pessoa              String    @db.Char(1)
  cpf_cnpj                 String?   @db.VarChar(20)
  nome                     String?   @db.VarChar(255)
  nome_fantasia            String?   @db.VarChar(255)
  cod_loja_cadastro        Int?
  inativo                  Boolean?
  status_cliente           String?   @db.VarChar(50)
  cliente                  Boolean?
  fornecedor               Boolean?
  representante            Boolean?
  guia_compra              Boolean?
  transportadora           Boolean?
  funcionario              Boolean?
  data_cadastro            DateTime? @db.Timestamp(6)
  data_ultima_alteracao    DateTime? @db.Timestamp(6)
  data_nascimento          DateTime? @db.Timestamp(6)
  data_fundacao            DateTime? @db.Timestamp(6)
  renda_mensal             Decimal?  @db.Decimal(14, 2)
  faturamento_mensal       Decimal?  @db.Decimal(14, 2)
  email_principal          String?   @db.VarChar(255)
  telefone_principal       String?   @db.VarChar(50)
  cep                      String?   @db.VarChar(20)
  cidade                   String?   @db.VarChar(100)
  uf                       String?   @db.VarChar(2)
  bairro                   String?   @db.VarChar(100)
  endereco                 String?   @db.VarChar(255)
  numero_endereco          Int?
  data_primeira_compra     DateTime? @db.Timestamp(6)
  valor_primeira_compra    Decimal?  @db.Decimal(14, 2)
  cod_loja_primeira_compra Int?
  data_ultima_compra       DateTime? @db.Timestamp(6)
  valor_ultima_compra      Decimal?  @db.Decimal(14, 2)
  cod_loja_ultima_compra   Int?
  qtd_compras              Decimal?  @db.Decimal(14, 2)
  valor_total_compras      Decimal?  @db.Decimal(14, 2)
  dados_api                Json
  criado_em                DateTime? @default(now()) @db.Timestamp(6)
  atualizado_em            DateTime? @default(now()) @db.Timestamp(6)

  @@index([cliente], map: "idx_dim_cliente_cliente")
  @@index([cpf_cnpj], map: "idx_dim_cliente_cpf_cnpj")
  @@index([data_ultima_alteracao], map: "idx_dim_cliente_data_alteracao")
  @@index([nome], map: "idx_dim_cliente_nome")
  @@index([data_primeira_compra], map: "idx_dim_cliente_primeira_compra")
  @@index([tipo_pessoa], map: "idx_dim_cliente_tipo")
  @@index([data_ultima_compra], map: "idx_dim_cliente_ultima_compra")
}

model produto_analitico {
  product_sku                 String    @id @db.VarChar(50)
  product_name                String?   @db.VarChar(255)
  color_code                  String?   @db.VarChar(10)
  color_name                  String?   @db.VarChar(100)
  size                        String?   @db.VarChar(20)
  ncm                         String?   @db.VarChar(20)
  cst                         String?   @db.VarChar(10)
  cest                        String?   @db.VarChar(20)
  is_active                   Boolean?
  is_finished_product         Boolean?
  is_raw_material             Boolean?

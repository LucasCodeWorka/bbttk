{
  "name": "pcp-api",
  "version": "1.0.0",
  "description": "API PCP Bebetenkite",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test:estoque": "npm run build && node --test tests/estoqueLocal.test.cjs tests/estoqueAnoAnterior.test.cjs",
    "test:ruptura": "npm run build && node --test tests/ruptura.test.cjs",
    "test:sem-venda": "npm run build && node --test tests/pecasSemVenda.test.cjs",
    "test:ativos": "npm run build && node --test tests/estoqueAtivos.test.cjs tests/ruptura.test.cjs",
    "test:cobertura": "npm run build && node --test tests/estoqueCobertura.test.cjs",
    "start": "node --max-old-space-size=384 dist/index.js",
    "db:generate": "prisma generate --schema=../api/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
